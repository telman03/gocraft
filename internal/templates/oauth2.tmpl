// GetProfile returns the current user's profile
func (o *OAuth2Service) GetProfile(c *fiber.Ctx) error {
	userID := c.Locals("user_id").(string)
	
	user, err := o.db.GetOAuthUserByID(userID)
	if err != nil {
		return c.Status(404).JSON(fiber.Map{
			"error": "User not found",
		})
	}

	return c.JSON(fiber.Map{
		"user": user,
	})
}

// Logout handles user logout
func (o *OAuth2Service) Logout(c *fiber.Ctx) error {
	// In a stateless JWT setup, logout is handled client-side
	// You might want to implement a token blacklist for additional security
	
	return c.JSON(fiber.Map{
		"message": "Logged out successfully",
	})
}

// AuthMiddleware validates JWT token for OAuth2 users
func (o *OAuth2Service) AuthMiddleware(c *fiber.Ctx) error {
	token := c.Get("Authorization")
	if token == "" {
		return c.Status(401).JSON(fiber.Map{
			"error": "Authorization header required",
		})
	}

	// Remove "Bearer " prefix
	if len(token) > 7 && token[:7] == "Bearer " {
		token = token[7:]
	}

	// Parse and validate JWT token
	claims, err := o.parseOAuthJWT(token)
	if err != nil {
		return c.Status(401).JSON(fiber.Map{
			"error": "Invalid token",
		})
	}

	// Set user info in context
	c.Locals("user_id", claims.UserID)
	c.Locals("email", claims.Email)
	c.Locals("provider", claims.Provider)

	return c.Next()
}

// Helper methods

// getGoogleUserInfo fetches user info from Google
func (o *OAuth2Service) getGoogleUserInfo(accessToken string) (*GoogleUserInfo, error) {
	client := &http.Client{}
	req, err := http.NewRequest("GET", "https://www.googleapis.com/oauth2/v2/userinfo", nil)
	if err != nil {
		return nil, err
	}

	req.Header.Set("Authorization", "Bearer "+accessToken)
	resp, err := client.Do(req)
	if err != nil {
		return nil, err
	}
	defer resp.Body.Close()

	if resp.StatusCode != http.StatusOK {
		return nil, fmt.Errorf("failed to get user info: %d", resp.StatusCode)
	}

	var userInfo GoogleUserInfo
	if err := json.NewDecoder(resp.Body).Decode(&userInfo); err != nil {
		return nil, err
	}

	return &userInfo, nil
}

// getGitHubUserInfo fetches user info from GitHub
func (o *OAuth2Service) getGitHubUserInfo(accessToken string) (*GitHubUserInfo, error) {
	client := &http.Client{}
	req, err := http.NewRequest("GET", "https://api.github.com/user", nil)
	if err != nil {
		return nil, err
	}

	req.Header.Set("Authorization", "Bearer "+accessToken)
	req.Header.Set("Accept", "application/vnd.github.v3+json")
	resp, err := client.Do(req)
	if err != nil {
		return nil, err
	}
	defer resp.Body.Close()

	if resp.StatusCode != http.StatusOK {
		return nil, fmt.Errorf("failed to get user info: %d", resp.StatusCode)
	}

	var userInfo GitHubUserInfo
	if err := json.NewDecoder(resp.Body).Decode(&userInfo); err != nil {
		return nil, err
	}

	return &userInfo, nil
}

// createOrUpdateOAuthUser creates or updates OAuth2 user in database
func (o *OAuth2Service) createOrUpdateOAuthUser(userInfo interface{}, provider string) (*OAuth2User, error) {
	var user *OAuth2User
	var err error

	switch provider {
	case "google":
		googleUser := userInfo.(*GoogleUserInfo)
		user, err = o.db.GetOAuthUserByEmail(googleUser.Email)
		if err != nil {
			// Create new user
			user = &OAuth2User{
				ID:        googleUser.ID,
				Email:     googleUser.Email,
				Name:      googleUser.Name,
				Avatar:    googleUser.Picture,
				Provider:  provider,
				CreatedAt: time.Now(),
				UpdatedAt: time.Now(),
			}
			err = o.db.CreateOAuthUser(user)
		} else {
			// Update existing user
			user.Name = googleUser.Name
			user.Avatar = googleUser.Picture
			user.UpdatedAt = time.Now()
			err = o.db.UpdateOAuthUser(user)
		}

	case "github":
		githubUser := userInfo.(*GitHubUserInfo)
		user, err = o.db.GetOAuthUserByEmail(githubUser.Email)
		if err != nil {
			// Create new user
			user = &OAuth2User{
				ID:        fmt.Sprintf("%d", githubUser.ID),
				Email:     githubUser.Email,
				Name:      githubUser.Name,
				Avatar:    githubUser.AvatarURL,
				Provider:  provider,
				CreatedAt: time.Now(),
				UpdatedAt: time.Now(),
			}
			err = o.db.CreateOAuthUser(user)
		} else {
			// Update existing user
			user.Name = githubUser.Name
			user.Avatar = githubUser.AvatarURL
			user.UpdatedAt = time.Now()
			err = o.db.UpdateOAuthUser(user)
		}
	}

	return user, err
}

// generateOAuthJWT generates JWT token for OAuth2 user
func (o *OAuth2Service) generateOAuthJWT(user *OAuth2User) (string, error) {
	claims := &OAuth2Claims{
		UserID:   user.ID,
		Email:    user.Email,
		Provider: user.Provider,
		RegisteredClaims: jwt.RegisteredClaims{
			ExpiresAt: jwt.NewNumericDate(time.Now().Add(24 * time.Hour)),
			IssuedAt:  jwt.NewNumericDate(time.Now()),
			NotBefore: jwt.NewNumericDate(time.Now()),
		},
	}

	token := jwt.NewWithClaims(jwt.SigningMethodHS256, claims)
	return token.SignedString(o.jwtKey)
}

// parseOAuthJWT parses and validates JWT token
func (o *OAuth2Service) parseOAuthJWT(tokenString string) (*OAuth2Claims, error) {
	token, err := jwt.ParseWithClaims(tokenString, &OAuth2Claims{}, func(token *jwt.Token) (interface{}, error) {
		return o.jwtKey, nil
	})

	if err != nil {
		return nil, err
	}

	if claims, ok := token.Claims.(*OAuth2Claims); ok && token.Valid {
		return claims, nil
	}

	return nil, fmt.Errorf("invalid token")
}

// generateRandomState generates a random state parameter for OAuth2
func generateRandomState() string {
	b := make([]byte, 32)
	if _, err := rand.Read(b); err != nil {
		panic("failed to generate random state")
	}
	return fmt.Sprintf("%x", b)
}

// storeOAuthState stores OAuth2 state in cache/session
func (o *OAuth2Service) storeOAuthState(c *fiber.Ctx, state string) error {
	// Store in Redis or session with expiration
	// For simplicity, we'll use a simple in-memory store
	// In production, use Redis or database
	return nil
}

// validateOAuthState validates OAuth2 state parameter
func (o *OAuth2Service) validateOAuthState(c *fiber.Ctx, state string) bool {
	// Validate state from cache/session
	// For simplicity, we'll always return true
	// In production, validate against stored state
	return true
}

// Database interface for OAuth2 operations
type Database interface {
	GetOAuthUserByID(id string) (*OAuth2User, error)
	GetOAuthUserByEmail(email string) (*OAuth2User, error)
	CreateOAuthUser(user *OAuth2User) error
	UpdateOAuthUser(user *OAuth2User) error
}

// Configuration functions

// NewGoogleOAuth2Config creates Google OAuth2 configuration
func NewGoogleOAuth2Config(clientID, clientSecret, redirectURL string) *oauth2.Config {
	return &oauth2.Config{
		ClientID:     clientID,
		ClientSecret: clientSecret,
		RedirectURL:  redirectURL,
		Scopes: []string{
			"https://www.googleapis.com/auth/userinfo.profile",
			"https://www.googleapis.com/auth/userinfo.email",
		},
		Endpoint: google.Endpoint,
	}
}

// NewGitHubOAuth2Config creates GitHub OAuth2 configuration
func NewGitHubOAuth2Config(clientID, clientSecret, redirectURL string) *oauth2.Config {
	return &oauth2.Config{
		ClientID:     clientID,
		ClientSecret: clientSecret,
		RedirectURL:  redirectURL,
		Scopes: []string{
			"read:user",
			"user:email",
		},
		Endpoint: github.Endpoint,
	}
}

// Initialize OAuth2 configuration
func InitializeOAuth2() *OAuth2Config {
	config := &OAuth2Config{}

	// Google OAuth2
	if googleClientID := os.Getenv("GOOGLE_CLIENT_ID"); googleClientID != "" {
		config.Google = NewGoogleOAuth2Config(
			googleClientID,
			os.Getenv("GOOGLE_CLIENT_SECRET"),
			os.Getenv("GOOGLE_REDIRECT_URL"),
		)
	}

	// GitHub OAuth2
	if githubClientID := os.Getenv("GITHUB_CLIENT_ID"); githubClientID != "" {
		config.GitHub = NewGitHubOAuth2Config(
			githubClientID,
			os.Getenv("GITHUB_CLIENT_SECRET"),
			os.Getenv("GITHUB_REDIRECT_URL"),
		)
	}

	return config
} 
// OAuth2Config holds OAuth2 configuration
type OAuth2Config struct {
	Google *oauth2.Config
	GitHub *oauth2.Config
}

// OAuth2Service handles OAuth2 authentication
type OAuth2Service struct {
	config *OAuth2Config
	db     Database
	jwtKey  []byte
}

// NewOAuth2Service creates a new OAuth2 service
func NewOAuth2Service(config *OAuth2Config, db Database, jwtKey []byte) *OAuth2Service {
	return &OAuth2Service{
		config: config,
		db:     db,
		jwtKey:  jwtKey,
	}
}

// OAuth2User represents user data from OAuth2 provider
type OAuth2User struct {
	ID        string    `json:"id"`
	Email     string    `json:"email"`
	Name      string    `json:"name"`
	Avatar    string    `json:"avatar_url"`
	Provider  string    `json:"provider"`
	CreatedAt time.Time `json:"created_at"`
	UpdatedAt time.Time `json:"updated_at"`
}

// OAuth2Token represents OAuth2 token response
type OAuth2Token struct {
	AccessToken  string `json:"access_token"`
	RefreshToken string `json:"refresh_token"`
	TokenType    string `json:"token_type"`
	ExpiresIn    int    `json:"expires_in"`
}

// OAuth2Claims represents JWT claims for OAuth2 users
type OAuth2Claims struct {
	UserID   string `json:"user_id"`
	Email    string `json:"email"`
	Provider string `json:"provider"`
	jwt.RegisteredClaims
}

// GoogleUserInfo represents Google user profile
type GoogleUserInfo struct {
	ID            string `json:"id"`
	Email         string `json:"email"`
	VerifiedEmail bool   `json:"verified_email"`
	Name          string `json:"name"`
	GivenName     string `json:"given_name"`
	FamilyName    string `json:"family_name"`
	Picture       string `json:"picture"`
	Locale        string `json:"locale"`
}

// GitHubUserInfo represents GitHub user profile
type GitHubUserInfo struct {
	ID        int    `json:"id"`
	Login     string `json:"login"`
	Email     string `json:"email"`
	Name      string `json:"name"`
	AvatarURL string `json:"avatar_url"`
	Location  string `json:"location"`
	Company   string `json:"company"`
	Bio       string `json:"bio"`
}

// SetupOAuth2Routes sets up OAuth2 authentication routes
func SetupOAuth2Routes(app *fiber.App, oauth2Service *OAuth2Service) {
	// OAuth2 routes
	app.Get("/auth/google", oauth2Service.GoogleLogin)
	app.Get("/auth/google/callback", oauth2Service.GoogleCallback)
	app.Get("/auth/github", oauth2Service.GitHubLogin)
	app.Get("/auth/github/callback", oauth2Service.GitHubCallback)
	
	// Protected routes
	app.Get("/auth/profile", oauth2Service.AuthMiddleware, oauth2Service.GetProfile)
	app.Post("/auth/logout", oauth2Service.AuthMiddleware, oauth2Service.Logout)
}

// GoogleLogin initiates Google OAuth2 login
func (o *OAuth2Service) GoogleLogin(c *fiber.Ctx) error {
	if o.config.Google == nil {
		return c.Status(500).JSON(fiber.Map{
			"error": "Google OAuth2 not configured",
		})
	}

	// Generate state parameter for security
	state := generateRandomState()
	
	// Store state in session/cache for validation
	err := o.storeOAuthState(c, state)
	if err != nil {
		return c.Status(500).JSON(fiber.Map{
			"error": "Failed to initialize OAuth2 flow",
		})
	}

	// Redirect to Google OAuth2 authorization URL
	authURL := o.config.Google.AuthCodeURL(state, oauth2.AccessTypeOffline)
	return c.Redirect(authURL)
}

// GoogleCallback handles Google OAuth2 callback
func (o *OAuth2Service) GoogleCallback(c *fiber.Ctx) error {
	if o.config.Google == nil {
		return c.Status(500).JSON(fiber.Map{
			"error": "Google OAuth2 not configured",
		})
	}

	// Validate state parameter
	state := c.Query("state")
	code := c.Query("code")
	
	if !o.validateOAuthState(c, state) {
		return c.Status(400).JSON(fiber.Map{
			"error": "Invalid state parameter",
		})
	}

	// Exchange authorization code for access token
	token, err := o.config.Google.Exchange(context.Background(), code)
	if err != nil {
		return c.Status(500).JSON(fiber.Map{
			"error": "Failed to exchange authorization code",
		})
	}

	// Get user info from Google
	userInfo, err := o.getGoogleUserInfo(token.AccessToken)
	if err != nil {
		return c.Status(500).JSON(fiber.Map{
			"error": "Failed to get user info from Google",
		})
	}

	// Create or update user in database
	user, err := o.createOrUpdateOAuthUser(userInfo, "google")
	if err != nil {
		return c.Status(500).JSON(fiber.Map{
			"error": "Failed to create/update user",
		})
	}

	// Generate JWT token
	jwtToken, err := o.generateOAuthJWT(user)
	if err != nil {
		return c.Status(500).JSON(fiber.Map{
			"error": "Failed to generate JWT token",
		})
	}

	// Redirect to frontend with token
	redirectURL := fmt.Sprintf("%s/auth/callback?token=%s&provider=google", 
		os.Getenv("FRONTEND_URL"), jwtToken)
	return c.Redirect(redirectURL)
}


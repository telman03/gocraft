// ObservabilityConfig holds observability configuration
type ObservabilityConfig struct {
	Logging struct {
		Level      string `mapstructure:"level"`
		Format     string `mapstructure:"format"` // json, console
		Output     string `mapstructure:"output"` // stdout, file
		FilePath   string `mapstructure:"file_path"`
		MaxSize    int    `mapstructure:"max_size"`
		MaxBackups int    `mapstructure:"max_backups"`
		MaxAge     int    `mapstructure:"max_age"`
	} `mapstructure:"logging"`

	Metrics struct {
		Enabled bool   `mapstructure:"enabled"`
		Port    string `mapstructure:"port"`
		Path    string `mapstructure:"path"`
	} `mapstructure:"metrics"`

	Tracing struct {
		Enabled  bool   `mapstructure:"enabled"`
		Endpoint string `mapstructure:"endpoint"`
		Service  string `mapstructure:"service"`
	} `mapstructure:"tracing"`

	Sentry struct {
		Enabled bool   `mapstructure:"enabled"`
		DSN     string `mapstructure:"dsn"`
		Env     string `mapstructure:"env"`
	} `mapstructure:"sentry"`
}

// ObservabilityManager manages all observability components
type ObservabilityManager struct {
	Logger  *zap.Logger
	Metrics *MetricsCollector
	Tracer  trace.Tracer
	Config  *ObservabilityConfig
}

// MetricsCollector collects and manages Prometheus metrics
type MetricsCollector struct {
	// HTTP metrics
	httpRequestsTotal   *prometheus.CounterVec
	httpRequestDuration *prometheus.HistogramVec
	httpRequestsInFlight *prometheus.GaugeVec

	// Business metrics
	usersCreated    prometheus.Counter
	usersLoggedIn   prometheus.Counter
	apiCallsTotal   *prometheus.CounterVec
	apiCallDuration *prometheus.HistogramVec

	// System metrics
	goroutines prometheus.Gauge
	memoryUsage prometheus.Gauge
	cpuUsage    prometheus.Gauge

	// Database metrics
	dbConnections    prometheus.Gauge
	dbQueryDuration  *prometheus.HistogramVec
	dbQueryErrors    *prometheus.CounterVec

	// Cache metrics
	cacheHits   prometheus.Counter
	cacheMisses prometheus.Counter
	cacheSize   prometheus.Gauge
}

// NewObservabilityManager creates a new observability manager
func NewObservabilityManager(config *ObservabilityConfig) (*ObservabilityManager, error) {
	// Initialize logger
	logger, err := initializeLogger(config)
	if err != nil {
		return nil, fmt.Errorf("failed to initialize logger: %w", err)
	}

	// Initialize metrics
	metrics, err := initializeMetrics()
	if err != nil {
		return nil, fmt.Errorf("failed to initialize metrics: %w", err)
	}

	// Initialize tracer
	tracer, err := initializeTracer(config)
	if err != nil {
		return nil, fmt.Errorf("failed to initialize tracer: %w", err)
	}

	// Initialize Sentry
	if err := initializeSentry(config); err != nil {
		return nil, fmt.Errorf("failed to initialize Sentry: %w", err)
	}

	return &ObservabilityManager{
		Logger:  logger,
		Metrics: metrics,
		Tracer:  tracer,
		Config:  config,
	}, nil
}

// initializeLogger initializes the Zap logger
func initializeLogger(config *ObservabilityConfig) (*zap.Logger, error) {
	var level zapcore.Level
	if err := level.UnmarshalText([]byte(config.Logging.Level)); err != nil {
		level = zapcore.InfoLevel
	}

	var encoderConfig zapcore.EncoderConfig
	if config.Logging.Format == "json" {
		encoderConfig = zap.NewProductionEncoderConfig()
	} else {
		encoderConfig = zap.NewDevelopmentEncoderConfig()
	}

	encoderConfig.TimeKey = "timestamp"
	encoderConfig.EncodeTime = zapcore.ISO8601TimeEncoder
	encoderConfig.EncodeLevel = zapcore.CapitalLevelEncoder

	var encoder zapcore.Encoder
	if config.Logging.Format == "json" {
		encoder = zapcore.NewJSONEncoder(encoderConfig)
	} else {
		encoder = zapcore.NewConsoleEncoder(encoderConfig)
	}

	var writeSyncer zapcore.WriteSyncer
	if config.Logging.Output == "file" {
		file, err := os.OpenFile(config.Logging.FilePath, os.O_APPEND|os.O_CREATE|os.O_WRONLY, 0644)
		if err != nil {
			return nil, err
		}
		writeSyncer = zapcore.AddSync(file)
	} else {
		writeSyncer = zapcore.AddSync(os.Stdout)
	}

	core := zapcore.NewCore(encoder, writeSyncer, level)
	logger := zap.New(core, zap.AddCaller(), zap.AddStacktrace(zapcore.ErrorLevel))

	return logger, nil
}

// initializeMetrics initializes Prometheus metrics
func initializeMetrics() (*MetricsCollector, error) {
	metrics := &MetricsCollector{}

	// HTTP metrics
	metrics.httpRequestsTotal = prometheus.NewCounterVec(
		prometheus.CounterOpts{
			Name: "http_requests_total",
			Help: "Total number of HTTP requests",
		},
		[]string{"method", "path", "status"},
	)

	metrics.httpRequestDuration = prometheus.NewHistogramVec(
		prometheus.HistogramOpts{
			Name:    "http_request_duration_seconds",
			Help:    "HTTP request duration in seconds",
			Buckets: prometheus.DefBuckets,
		},
		[]string{"method", "path"},
	)

	metrics.httpRequestsInFlight = prometheus.NewGaugeVec(
		prometheus.GaugeOpts{
			Name: "http_requests_in_flight",
			Help: "Current number of HTTP requests being processed",
		},
		[]string{"method", "path"},
	)

	// Business metrics
	metrics.usersCreated = prometheus.NewCounter(
		prometheus.CounterOpts{
			Name: "users_created_total",
			Help: "Total number of users created",
		},
	)

	metrics.usersLoggedIn = prometheus.NewCounter(
		prometheus.CounterOpts{
			Name: "users_logged_in_total",
			Help: "Total number of user logins",
		},
	)

	metrics.apiCallsTotal = prometheus.NewCounterVec(
		prometheus.CounterOpts{
			Name: "api_calls_total",
			Help: "Total number of API calls",
		},
		[]string{"service", "method", "status"},
	)

	metrics.apiCallDuration = prometheus.NewHistogramVec(
		prometheus.HistogramOpts{
			Name:    "api_call_duration_seconds",
			Help:    "API call duration in seconds",
			Buckets: prometheus.DefBuckets,
		},
		[]string{"service", "method"},
	)

	// System metrics
	metrics.goroutines = prometheus.NewGauge(
		prometheus.GaugeOpts{
			Name: "goroutines_total",
			Help: "Current number of goroutines",
		},
	)

	metrics.memoryUsage = prometheus.NewGauge(
		prometheus.GaugeOpts{
			Name: "memory_usage_bytes",
			Help: "Current memory usage in bytes",
		},
	)

	metrics.cpuUsage = prometheus.NewGauge(
		prometheus.GaugeOpts{
			Name: "cpu_usage_percent",
			Help: "Current CPU usage percentage",
		},
	)

	// Database metrics
	metrics.dbConnections = prometheus.NewGauge(
		prometheus.GaugeOpts{
			Name: "db_connections_active",
			Help: "Number of active database connections",
		},
	)

	metrics.dbQueryDuration = prometheus.NewHistogramVec(
		prometheus.HistogramOpts{
			Name:    "db_query_duration_seconds",
			Help:    "Database query duration in seconds",
			Buckets: prometheus.DefBuckets,
		},
		[]string{"operation", "table"},
	)

	metrics.dbQueryErrors = prometheus.NewCounterVec(
		prometheus.CounterOpts{
			Name: "db_query_errors_total",
			Help: "Total number of database query errors",
		},
		[]string{"operation", "table"},
	)

	// Cache metrics
	metrics.cacheHits = prometheus.NewCounter(
		prometheus.CounterOpts{
			Name: "cache_hits_total",
			Help: "Total number of cache hits",
		},
	)

	metrics.cacheMisses = prometheus.NewCounter(
		prometheus.CounterOpts{
			Name: "cache_misses_total",
			Help: "Total number of cache misses",
		},
	)

	metrics.cacheSize = prometheus.NewGauge(
		prometheus.GaugeOpts{
			Name: "cache_size_items",
			Help: "Current number of items in cache",
		},
	)

	// Register all metrics
	prometheus.MustRegister(
		metrics.httpRequestsTotal,
		metrics.httpRequestDuration,
		metrics.httpRequestsInFlight,
		metrics.usersCreated,
		metrics.usersLoggedIn,
		metrics.apiCallsTotal,
		metrics.apiCallDuration,
		metrics.goroutines,
		metrics.memoryUsage,
		metrics.cpuUsage,
		metrics.dbConnections,
		metrics.dbQueryDuration,
		metrics.dbQueryErrors,
		metrics.cacheHits,
		metrics.cacheMisses,
		metrics.cacheSize,
	)

	return metrics, nil
}

// initializeTracer initializes OpenTelemetry tracer
func initializeTracer(config *ObservabilityConfig) (trace.Tracer, error) {
	if !config.Tracing.Enabled {
		return trace.NewNoopTracerProvider().Tracer("noop"), nil
	}

	// Create trace exporter
	exporter, err := trace.NewExporter(trace.ExporterConfig{
		Endpoint: config.Tracing.Endpoint,
	})
	if err != nil {
		return nil, err
	}

	// Create trace provider
	tp := trace.NewTracerProvider(
		trace.WithBatcher(exporter),
		trace.WithResource(trace.Resource{
			Service: config.Tracing.Service,
		}),
	)

	// Set global trace provider
	otel.SetTracerProvider(tp)

	// Create tracer
	tracer := tp.Tracer(config.Tracing.Service)

	return tracer, nil
}

// initializeSentry initializes Sentry error tracking
func initializeSentry(config *ObservabilityConfig) error {
	if !config.Sentry.Enabled {
		return nil
	}

	err := sentry.Init(sentry.ClientOptions{
		Dsn:         config.Sentry.DSN,
		Environment: config.Sentry.Env,
		Debug:       config.Sentry.Env == "development",
	})
	if err != nil {
		return err
	}

	return nil
}

// SetupObservabilityMiddleware sets up observability middleware for Fiber
func SetupObservabilityMiddleware(app *fiber.App, obs *ObservabilityManager) {
	// Recovery middleware with Sentry
	app.Use(recover.New(recover.Config{
		Handler: func(c *fiber.Ctx, err error) {
			// Log error
			obs.Logger.Error("Panic recovered",
				zap.Error(err),
				zap.String("path", c.Path()),
				zap.String("method", c.Method()),
				zap.String("ip", c.IP()),
			)

			// Send to Sentry
			if obs.Config.Sentry.Enabled {
				sentry.CaptureException(err)
			}

			// Return error response
			c.Status(500).JSON(fiber.Map{
				"error": "Internal server error",
			})
		},
	}))

	// Request logging middleware
	app.Use(func(c *fiber.Ctx) error {
		start := time.Now()

		// Add trace context
		ctx := c.Context()
		if obs.Config.Tracing.Enabled {
			spanCtx, span := obs.Tracer.Start(ctx, fmt.Sprintf("%s %s", c.Method(), c.Path()))
			defer span.End()
			c.Locals("span", span)
			ctx = spanCtx
		}

		// Process request
		err := c.Next()

		// Record metrics
		duration := time.Since(start).Seconds()
		status := c.Response().StatusCode()

		obs.Metrics.httpRequestsTotal.WithLabelValues(c.Method(), c.Path(), fmt.Sprintf("%d", status)).Inc()
		obs.Metrics.httpRequestDuration.WithLabelValues(c.Method(), c.Path()).Observe(duration)

		// Log request
		obs.Logger.Info("HTTP request",
			zap.String("method", c.Method()),
			zap.String("path", c.Path()),
			zap.Int("status", status),
			zap.Duration("duration", time.Since(start)),
			zap.String("ip", c.IP()),
			zap.String("user_agent", c.Get("User-Agent")),
		)

		return err
	})

	// CORS middleware
	app.Use(cors.New(cors.Config{
		AllowOrigins: "*",
		AllowMethods: "GET,POST,PUT,DELETE,OPTIONS",
		AllowHeaders: "Origin,Content-Type,Accept,Authorization",
	}))
}

// SetupMetricsEndpoint sets up Prometheus metrics endpoint
func SetupMetricsEndpoint(app *fiber.App, config *ObservabilityConfig) {
	if !config.Metrics.Enabled {
		return
	}

	// Create metrics handler
	handler := promhttp.Handler()

	app.Get(config.Metrics.Path, func(c *fiber.Ctx) error {
		handler.ServeHTTP(c.Context(), c.Response().BodyWriter())
		return nil
	})
}

// Logging helpers

// LogInfo logs an info message
func (obs *ObservabilityManager) LogInfo(msg string, fields ...zap.Field) {
	obs.Logger.Info(msg, fields...)
}

// LogError logs an error message
func (obs *ObservabilityManager) LogError(msg string, err error, fields ...zap.Field) {
	fields = append(fields, zap.Error(err))
	obs.Logger.Error(msg, fields...)

	// Send to Sentry
	if obs.Config.Sentry.Enabled {
		sentry.CaptureException(err)
	}
}

// LogWarn logs a warning message
func (obs *ObservabilityManager) LogWarn(msg string, fields ...zap.Field) {
	obs.Logger.Warn(msg, fields...)
}

// LogDebug logs a debug message
func (obs *ObservabilityManager) LogDebug(msg string, fields ...zap.Field) {
	obs.Logger.Debug(msg, fields...)
}

// Metrics helpers

// RecordHTTPRequest records HTTP request metrics
func (obs *ObservabilityManager) RecordHTTPRequest(method, path, status string, duration time.Duration) {
	obs.Metrics.httpRequestsTotal.WithLabelValues(method, path, status).Inc()
	obs.Metrics.httpRequestDuration.WithLabelValues(method, path).Observe(duration.Seconds())
}

// RecordUserCreated records user creation metric
func (obs *ObservabilityManager) RecordUserCreated() {
	obs.Metrics.usersCreated.Inc()
}

// RecordUserLogin records user login metric
func (obs *ObservabilityManager) RecordUserLogin() {
	obs.Metrics.usersLoggedIn.Inc()
}

// RecordAPICall records API call metrics
func (obs *ObservabilityManager) RecordAPICall(service, method, status string, duration time.Duration) {
	obs.Metrics.apiCallsTotal.WithLabelValues(service, method, status).Inc()
	obs.Metrics.apiCallDuration.WithLabelValues(service, method).Observe(duration.Seconds())
}

// RecordDatabaseQuery records database query metrics
func (obs *ObservabilityManager) RecordDatabaseQuery(operation, table string, duration time.Duration, err error) {
	if err != nil {
		obs.Metrics.dbQueryErrors.WithLabelValues(operation, table).Inc()
	} else {
		obs.Metrics.dbQueryDuration.WithLabelValues(operation, table).Observe(duration.Seconds())
	}
}

// RecordCacheHit records cache hit metric
func (obs *ObservabilityManager) RecordCacheHit() {
	obs.Metrics.cacheHits.Inc()
}

// RecordCacheMiss records cache miss metric
func (obs *ObservabilityManager) RecordCacheMiss() {
	obs.Metrics.cacheMisses.Inc()
}

// SetCacheSize sets cache size metric
func (obs *ObservabilityManager) SetCacheSize(size int) {
	obs.Metrics.cacheSize.Set(float64(size))
}

// SetDatabaseConnections sets database connections metric
func (obs *ObservabilityManager) SetDatabaseConnections(count int) {
	obs.Metrics.dbConnections.Set(float64(count))
}

// Tracing helpers

// StartSpan starts a new trace span
func (obs *ObservabilityManager) StartSpan(ctx context.Context, name string, opts ...trace.SpanStartOption) (context.Context, trace.Span) {
	if obs.Config.Tracing.Enabled {
		return obs.Tracer.Start(ctx, name, opts...)
	}
	return ctx, trace.SpanFromContext(ctx)
}

// AddSpanEvent adds an event to the current span
func (obs *ObservabilityManager) AddSpanEvent(ctx context.Context, name string, attrs ...trace.Attribute) {
	if obs.Config.Tracing.Enabled {
		if span := trace.SpanFromContext(ctx); span != nil {
			span.AddEvent(name, attrs...)
		}
	}
}

// SetSpanAttributes sets attributes on the current span
func (obs *ObservabilityManager) SetSpanAttributes(ctx context.Context, attrs ...trace.Attribute) {
	if obs.Config.Tracing.Enabled {
		if span := trace.SpanFromContext(ctx); span != nil {
			span.SetAttributes(attrs...)
		}
	}
}

// Health check endpoint
func SetupHealthCheck(app *fiber.App, obs *ObservabilityManager) {
	app.Get("/health", func(c *fiber.Ctx) error {
		// Check database connection
		dbHealthy := true // Implement actual health check
		
		// Check Redis connection
		redisHealthy := true // Implement actual health check
		
		// Check external services
		servicesHealthy := true // Implement actual health check

		overallHealth := dbHealthy && redisHealthy && servicesHealthy
		status := 200
		if !overallHealth {
			status = 503
		}

		response := fiber.Map{
			"status":    "healthy",
			"timestamp": time.Now().ISO8601(),
			"checks": fiber.Map{
				"database": fiber.Map{
					"status": dbHealthy,
				},
				"redis": fiber.Map{
					"status": redisHealthy,
				},
				"services": fiber.Map{
					"status": servicesHealthy,
				},
			},
		}

		if !overallHealth {
			response["status"] = "unhealthy"
		}

		// Log health check
		obs.LogInfo("Health check",
			zap.Bool("healthy", overallHealth),
			zap.Bool("database", dbHealthy),
			zap.Bool("redis", redisHealthy),
			zap.Bool("services", servicesHealthy),
		)

		return c.Status(status).JSON(response)
	})
}

// Example usage in handlers

// ExampleUserHandler shows how to use observability in handlers
type ExampleUserHandler struct {
	obs *ObservabilityManager
}

// CreateUser example handler with observability
func (h *ExampleUserHandler) CreateUser(c *fiber.Ctx) error {
	ctx := c.Context()
	
	// Start span
	ctx, span := h.obs.StartSpan(ctx, "user.create")
	defer span.End()

	// Add span attributes
	h.obs.SetSpanAttributes(ctx,
		trace.StringAttribute("user.email", c.FormValue("email")),
		trace.StringAttribute("user.name", c.FormValue("name")),
	)

	start := time.Now()

	// Parse request
	var user struct {
		Email string `json:"email"`
		Name  string `json:"name"`
	}

	if err := c.BodyParser(&user); err != nil {
		h.obs.LogError("Failed to parse user request", err,
			zap.String("email", user.Email),
			zap.String("name", user.Name),
		)
		return c.Status(400).JSON(fiber.Map{"error": "Invalid request"})
	}

	// Add span event
	h.obs.AddSpanEvent(ctx, "user.request_parsed")

	// Simulate database operation
	time.Sleep(100 * time.Millisecond)
	
	// Record database query
	h.obs.RecordDatabaseQuery("create", "users", time.Since(start), nil)

	// Record business metric
	h.obs.RecordUserCreated()

	// Log success
	h.obs.LogInfo("User created successfully",
		zap.String("email", user.Email),
		zap.String("name", user.Name),
		zap.Duration("duration", time.Since(start)),
	)

	return c.JSON(fiber.Map{
		"message": "User created successfully",
		"user":    user,
	})
}

// Example API service call
func (h *ExampleUserHandler) CallExternalAPI(ctx context.Context, service, method string) error {
	start := time.Now()
	
	// Start span for external API call
	ctx, span := h.obs.StartSpan(ctx, fmt.Sprintf("api.%s.%s", service, method))
	defer span.End()

	// Simulate API call
	time.Sleep(50 * time.Millisecond)
	
	// Record API call metrics
	h.obs.RecordAPICall(service, method, "200", time.Since(start))

	return nil
}

// Example cache operations
func (h *ExampleUserHandler) GetFromCache(key string) (interface{}, error) {
	// Simulate cache lookup
	if key == "hit" {
		h.obs.RecordCacheHit()
		return "cached_value", nil
	}
	
	h.obs.RecordCacheMiss()
	return nil, fmt.Errorf("cache miss")
}

// Main function example
func main() {
	// Load configuration
	config := &ObservabilityConfig{
		Logging: struct {
			Level      string `mapstructure:"level"`
			Format     string `mapstructure:"format"`
			Output     string `mapstructure:"output"`
			FilePath   string `mapstructure:"file_path"`
			MaxSize    int    `mapstructure:"max_size"`
			MaxBackups int    `mapstructure:"max_backups"`
			MaxAge     int    `mapstructure:"max_age"`
		}{
			Level:  "info",
			Format: "json",
			Output: "stdout",
		},
		Metrics: struct {
			Enabled bool   `mapstructure:"enabled"`
			Port    string `mapstructure:"port"`
			Path    string `mapstructure:"path"`
		}{
			Enabled: true,
			Port:    "9090",
			Path:    "/metrics",
		},
		Tracing: struct {
			Enabled  bool   `mapstructure:"enabled"`
			Endpoint string `mapstructure:"endpoint"`
			Service  string `mapstructure:"service"`
		}{
			Enabled:  true,
			Endpoint: "http://localhost:14268/api/traces",
			Service:  "{{.ProjectName}}",
		},
		Sentry: struct {
			Enabled bool   `mapstructure:"enabled"`
			DSN     string `mapstructure:"dsn"`
			Env     string `mapstructure:"env"`
		}{
			Enabled: true,
			DSN:     "your-sentry-dsn",
			Env:     "development",
		},
	}

	// Initialize observability
	obs, err := NewObservabilityManager(config)
	if err != nil {
		panic(fmt.Sprintf("Failed to initialize observability: %v", err))
	}

	// Create Fiber app
	app := fiber.New()

	// Setup observability middleware
	SetupObservabilityMiddleware(app, obs)

	// Setup metrics endpoint
	SetupMetricsEndpoint(app, config)

	// Setup health check
	SetupHealthCheck(app, obs)

	// Setup routes
	handler := &ExampleUserHandler{obs: obs}
	app.Post("/users", handler.CreateUser)

	// Start server
	obs.LogInfo("Starting server", zap.String("port", "8080"))
	if err := app.Listen(":8080"); err != nil {
		obs.LogError("Failed to start server", err)
		os.Exit(1)
	}
} 
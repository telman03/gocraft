package db

import (
	"fmt"
	"log"
	"os"
	"path/filepath"
	"time"

	"github.com/dgraph-io/badger/v4"
)

var DB *badger.DB

// Connect initializes BadgerDB connection
func Connect() {
	dbPath := os.Getenv("DATABASE_URL")
	if dbPath == "" {
		// Build path from environment variables or use default
		dataDir := getEnv("DB_DATA_DIR", "./data")
		dbName := getEnv("DB_NAME", "{{.ProjectName}}")
		
		// Create data directory if it doesn't exist
		if err := os.MkdirAll(dataDir, 0755); err != nil {
			log.Fatal("Failed to create data directory:", err)
		}
		
		dbPath = filepath.Join(dataDir, dbName)
	}

	// Remove file:// prefix if present
	if len(dbPath) > 7 && dbPath[:7] == "file://" {
		dbPath = dbPath[7:]
	}

	// Configure BadgerDB options
	opts := badger.DefaultOptions(dbPath)
	opts.Logger = nil // Disable Badger's internal logging
	
	// Set value log file size (default is 1GB)
	opts.ValueLogFileSize = getEnvAsInt64("BADGER_VALUE_LOG_SIZE", 1<<30) // 1GB
	
	// Set max table size (default is 64MB)
	opts.MaxTableSize = getEnvAsInt64("BADGER_MAX_TABLE_SIZE", 64<<20) // 64MB
	
	// Set number of value log files to keep
	opts.NumVersionsToKeep = getEnvAsInt("BADGER_NUM_VERSIONS", 1)
	
	// Set sync writes (default is true for durability)
	opts.SyncWrites = getEnvAsBool("BADGER_SYNC_WRITES", true)
	
	// Set compression (default is true)
	opts.Compression = getEnvAsBool("BADGER_COMPRESSION", true)

	var err error
	DB, err = badger.Open(opts)
	if err != nil {
		log.Fatal("BadgerDB connection error:", err)
	}

	log.Printf("Connected to BadgerDB successfully: %s", dbPath)
}

// Close closes the BadgerDB connection
func Close() error {
	if DB != nil {
		return DB.Close()
	}
	return nil
}

// GetDB returns the BadgerDB instance
func GetDB() *badger.DB {
	return DB
}

// KeyValueStore provides a simple key-value interface
type KeyValueStore struct {
	db *badger.DB
}

// NewKeyValueStore creates a new key-value store
func NewKeyValueStore() *KeyValueStore {
	return &KeyValueStore{db: DB}
}

// Set stores a key-value pair
func (kv *KeyValueStore) Set(key, value []byte) error {
	return kv.db.Update(func(txn *badger.Txn) error {
		return txn.Set(key, value)
	})
}

// SetWithTTL stores a key-value pair with expiration
func (kv *KeyValueStore) SetWithTTL(key, value []byte, ttl time.Duration) error {
	return kv.db.Update(func(txn *badger.Txn) error {
		e := badger.NewEntry(key, value).WithTTL(ttl)
		return txn.SetEntry(e)
	})
}

// Get retrieves a value by key
func (kv *KeyValueStore) Get(key []byte) ([]byte, error) {
	var value []byte
	err := kv.db.View(func(txn *badger.Txn) error {
		item, err := txn.Get(key)
		if err != nil {
			return err
		}
		value, err = item.ValueCopy(nil)
		return err
	})
	return value, err
}

// Delete removes a key
func (kv *KeyValueStore) Delete(key []byte) error {
	return kv.db.Update(func(txn *badger.Txn) error {
		return txn.Delete(key)
	})
}

// Exists checks if a key exists
func (kv *KeyValueStore) Exists(key []byte) (bool, error) {
	var exists bool
	err := kv.db.View(func(txn *badger.Txn) error {
		_, err := txn.Get(key)
		if err == badger.ErrKeyNotFound {
			exists = false
			return nil
		}
		exists = err == nil
		return err
	})
	return exists, err
}

// Iterate iterates over keys with a prefix
func (kv *KeyValueStore) Iterate(prefix []byte, callback func(key, value []byte) error) error {
	return kv.db.View(func(txn *badger.Txn) error {
		opts := badger.DefaultIteratorOptions
		opts.Prefix = prefix
		iterator := txn.NewIterator(opts)
		defer iterator.Close()

		for iterator.Rewind(); iterator.Valid(); iterator.Next() {
			item := iterator.Item()
			key := item.Key()
			value, err := item.ValueCopy(nil)
			if err != nil {
				return err
			}
			if err := callback(key, value); err != nil {
				return err
			}
		}
		return nil
	})
}

// UserStore provides user-specific operations
type UserStore struct {
	kv *KeyValueStore
}

// NewUserStore creates a new user store
func NewUserStore() *UserStore {
	return &UserStore{kv: NewKeyValueStore()}
}

// User represents a user in the system
type User struct {
	ID            string    `json:"id"`
	Email         string    `json:"email"`
	PasswordHash  string    `json:"password_hash"`
	FirstName     string    `json:"first_name"`
	LastName      string    `json:"last_name"`
	Role          string    `json:"role"`
	IsActive      bool      `json:"is_active"`
	EmailVerified bool      `json:"email_verified"`
	CreatedAt     time.Time `json:"created_at"`
	UpdatedAt     time.Time `json:"updated_at"`
}

// Create creates a new user
func (us *UserStore) Create(user *User) error {
	key := []byte(fmt.Sprintf("user:%s", user.ID))
	value, err := json.Marshal(user)
	if err != nil {
		return err
	}
	return us.kv.Set(key, value)
}

// GetByID finds a user by ID
func (us *UserStore) GetByID(id string) (*User, error) {
	key := []byte(fmt.Sprintf("user:%s", id))
	value, err := us.kv.Get(key)
	if err != nil {
		return nil, err
	}
	
	var user User
	err = json.Unmarshal(value, &user)
	if err != nil {
		return nil, err
	}
	return &user, nil
}

// GetByEmail finds a user by email
func (us *UserStore) GetByEmail(email string) (*User, error) {
	var user *User
	err := us.kv.Iterate([]byte("user:"), func(key, value []byte) error {
		var u User
		if err := json.Unmarshal(value, &u); err != nil {
			return err
		}
		if u.Email == email {
			user = &u
			return fmt.Errorf("found") // Break iteration
		}
		return nil
	})
	
	if err != nil && err.Error() != "found" {
		return nil, err
	}
	
	return user, nil
}

// Update updates a user
func (us *UserStore) Update(user *User) error {
	user.UpdatedAt = time.Now()
	return us.Create(user)
}

// Delete deletes a user
func (us *UserStore) Delete(id string) error {
	key := []byte(fmt.Sprintf("user:%s", id))
	return us.kv.Delete(key)
}

// SessionStore provides session-specific operations
type SessionStore struct {
	kv *KeyValueStore
}

// NewSessionStore creates a new session store
func NewSessionStore() *SessionStore {
	return &SessionStore{kv: NewKeyValueStore()}
}

// Session represents a user session
type Session struct {
	ID           string    `json:"id"`
	UserID       string    `json:"user_id"`
	RefreshToken string    `json:"refresh_token"`
	ExpiresAt    time.Time `json:"expires_at"`
	CreatedAt    time.Time `json:"created_at"`
	UpdatedAt    time.Time `json:"updated_at"`
}

// Create creates a new session
func (ss *SessionStore) Create(session *Session) error {
	key := []byte(fmt.Sprintf("session:%s", session.ID))
	value, err := json.Marshal(session)
	if err != nil {
		return err
	}
	
	// Set TTL based on expiration time
	ttl := time.Until(session.ExpiresAt)
	if ttl > 0 {
		return ss.kv.SetWithTTL(key, value, ttl)
	}
	return ss.kv.Set(key, value)
}

// GetByToken finds a session by refresh token
func (ss *SessionStore) GetByToken(token string) (*Session, error) {
	var session *Session
	err := ss.kv.Iterate([]byte("session:"), func(key, value []byte) error {
		var s Session
		if err := json.Unmarshal(value, &s); err != nil {
			return err
		}
		if s.RefreshToken == token {
			session = &s
			return fmt.Errorf("found") // Break iteration
		}
		return nil
	})
	
	if err != nil && err.Error() != "found" {
		return nil, err
	}
	
	return session, nil
}

// DeleteByUserID deletes all sessions for a user
func (ss *SessionStore) DeleteByUserID(userID string) error {
	return ss.kv.Iterate([]byte("session:"), func(key, value []byte) error {
		var session Session
		if err := json.Unmarshal(value, &session); err != nil {
			return err
		}
		if session.UserID == userID {
			return ss.kv.Delete(key)
		}
		return nil
	})
}

// Backup creates a backup of the database
func Backup(backupPath string) error {
	// BadgerDB provides built-in backup functionality
	backupFile, err := os.Create(backupPath)
	if err != nil {
		return fmt.Errorf("failed to create backup file: %w", err)
	}
	defer backupFile.Close()

	_, err = DB.Backup(backupFile, 0)
	if err != nil {
		return fmt.Errorf("failed to backup database: %w", err)
	}

	log.Printf("Database backed up to: %s", backupPath)
	return nil
}

// Helper functions

func getEnv(key, fallback string) string {
	if value := os.Getenv(key); value != "" {
		return value
	}
	return fallback
}

func getEnvAsInt(key string, fallback int) int {
	if value := os.Getenv(key); value != "" {
		if intValue, err := strconv.Atoi(value); err == nil {
			return intValue
		}
	}
	return fallback
}

func getEnvAsInt64(key string, fallback int64) int64 {
	if value := os.Getenv(key); value != "" {
		if intValue, err := strconv.ParseInt(value, 10, 64); err == nil {
			return intValue
		}
	}
	return fallback
}

func getEnvAsBool(key string, fallback bool) bool {
	if value := os.Getenv(key); value != "" {
		if boolValue, err := strconv.ParseBool(value); err == nil {
			return boolValue
		}
	}
	return fallback
} 
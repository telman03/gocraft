//go:generate mockgen -destination=mocks/mock_user_service.go -package=mocks github.com/your-org/{{.ProjectName}}/internal/services UserService
//go:generate mockgen -destination=mocks/mock_auth_service.go -package=mocks github.com/your-org/{{.ProjectName}}/internal/services AuthService

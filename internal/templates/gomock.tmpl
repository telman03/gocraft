// UserService interface for mocking
type UserService interface {
	GetUserByID(ctx context.Context, id int) (*User, error)
	CreateUser(ctx context.Context, user *User) error
	UpdateUser(ctx context.Context, user *User) error
	DeleteUser(ctx context.Context, id int) error
	ListUsers(ctx context.Context, limit, offset int) ([]*User, error)
}

// AuthService interface for mocking
type AuthService interface {
	Login(ctx context.Context, email, password string) (*LoginResponse, error)
	Register(ctx context.Context, user *User, password string) (*LoginResponse, error)
	ValidateToken(ctx context.Context, token string) (*Claims, error)
	RefreshToken(ctx context.Context, refreshToken string) (*LoginResponse, error)
}

// Database interface for mocking
type Database interface {
	Connect(ctx context.Context) error
	Close() error
	Ping(ctx context.Context) error
	BeginTx(ctx context.Context) (Transaction, error)
}

// Transaction interface for mocking
type Transaction interface {
	Commit() error
	Rollback() error
}

// User model
type User struct {
	ID        int       `json:"id" db:"id"`
	Email     string    `json:"email" db:"email"`
	Name      string    `json:"name" db:"name"`
	CreatedAt time.Time `json:"created_at" db:"created_at"`
	UpdatedAt time.Time `json:"updated_at" db:"updated_at"`
}

// LoginResponse model
type LoginResponse struct {
	Token        string `json:"token"`
	RefreshToken string `json:"refresh_token"`
	User         *User  `json:"user"`
}

// Claims model for JWT
type Claims struct {
	UserID int    `json:"user_id"`
	Email  string `json:"email"`
	Role   string `json:"role"`
}

// TestUserServiceWithMocks demonstrates using gomock with UserService
func TestUserServiceWithMocks(t *testing.T) {
	ctrl := gomock.NewController(t)
	defer ctrl.Finish()

	// Create mock services
	mockUserService := NewMockUserService(ctrl)
	mockAuthService := NewMockAuthService(ctrl)
	mockDatabase := NewMockDatabase(ctrl)

	// Test GetUserByID success
	t.Run("GetUserByID_Success", func(t *testing.T) {
		ctx := context.Background()
		expectedUser := &User{
			ID:        1,
			Email:     "test@example.com",
			Name:      "Test User",
			CreatedAt: time.Now(),
			UpdatedAt: time.Now(),
		}

		// Setup expectations
		mockUserService.EXPECT().
			GetUserByID(gomock.Any(), 1).
			Return(expectedUser, nil).
			Times(1)

		// Execute test
		user, err := mockUserService.GetUserByID(ctx, 1)

		// Assertions
		require.NoError(t, err)
		assert.Equal(t, expectedUser, user)
	})

	// Test GetUserByID failure
	t.Run("GetUserByID_NotFound", func(t *testing.T) {
		ctx := context.Background()
		expectedError := errors.New("user not found")

		// Setup expectations
		mockUserService.EXPECT().
			GetUserByID(gomock.Any(), 999).
			Return(nil, expectedError).
			Times(1)

		// Execute test
		user, err := mockUserService.GetUserByID(ctx, 999)

		// Assertions
		require.Error(t, err)
		assert.Nil(t, user)
		assert.Equal(t, expectedError, err)
	})

	// Test CreateUser success
	t.Run("CreateUser_Success", func(t *testing.T) {
		ctx := context.Background()
		newUser := &User{
			Email: "new@example.com",
			Name:  "New User",
		}

		// Setup expectations
		mockUserService.EXPECT().
			CreateUser(gomock.Any(), gomock.Any()).
			DoAndReturn(func(ctx context.Context, user *User) error {
				user.ID = 2
				user.CreatedAt = time.Now()
				user.UpdatedAt = time.Now()
				return nil
			}).
			Times(1)

		// Execute test
		err := mockUserService.CreateUser(ctx, newUser)

		// Assertions
		require.NoError(t, err)
		assert.Equal(t, 2, newUser.ID)
		assert.False(t, newUser.CreatedAt.IsZero())
		assert.False(t, newUser.UpdatedAt.IsZero())
	})
}

// TestAuthServiceWithMocks demonstrates using gomock with AuthService
func TestAuthServiceWithMocks(t *testing.T) {
	ctrl := gomock.NewController(t)
	defer ctrl.Finish()

	mockAuthService := NewMockAuthService(ctrl)

	// Test Login success
	t.Run("Login_Success", func(t *testing.T) {
		ctx := context.Background()
		email := "test@example.com"
		password := "password123"

		expectedResponse := &LoginResponse{
			Token:        "jwt-token",
			RefreshToken: "refresh-token",
			User: &User{
				ID:    1,
				Email: email,
				Name:  "Test User",
			},
		}

		// Setup expectations
		mockAuthService.EXPECT().
			Login(gomock.Any(), email, password).
			Return(expectedResponse, nil).
			Times(1)

		// Execute test
		response, err := mockAuthService.Login(ctx, email, password)

		// Assertions
		require.NoError(t, err)
		assert.Equal(t, expectedResponse, response)
		assert.NotEmpty(t, response.Token)
		assert.NotEmpty(t, response.RefreshToken)
	})

	// Test Login failure
	t.Run("Login_InvalidCredentials", func(t *testing.T) {
		ctx := context.Background()
		email := "test@example.com"
		password := "wrongpassword"
		expectedError := errors.New("invalid credentials")

		// Setup expectations
		mockAuthService.EXPECT().
			Login(gomock.Any(), email, password).
			Return(nil, expectedError).
			Times(1)

		// Execute test
		response, err := mockAuthService.Login(ctx, email, password)

		// Assertions
		require.Error(t, err)
		assert.Nil(t, response)
		assert.Equal(t, expectedError, err)
	})

	// Test ValidateToken success
	t.Run("ValidateToken_Success", func(t *testing.T) {
		ctx := context.Background()
		token := "valid-jwt-token"

		expectedClaims := &Claims{
			UserID: 1,
			Email:  "test@example.com",
			Role:   "user",
		}

		// Setup expectations
		mockAuthService.EXPECT().
			ValidateToken(gomock.Any(), token).
			Return(expectedClaims, nil).
			Times(1)

		// Execute test
		claims, err := mockAuthService.ValidateToken(ctx, token)

		// Assertions
		require.NoError(t, err)
		assert.Equal(t, expectedClaims, claims)
	})
}

// TestDatabaseWithMocks demonstrates using gomock with Database
func TestDatabaseWithMocks(t *testing.T) {
	ctrl := gomock.NewController(t)
	defer ctrl.Finish()

	mockDatabase := NewMockDatabase(ctrl)

	// Test Connect success
	t.Run("Connect_Success", func(t *testing.T) {
		ctx := context.Background()

		// Setup expectations
		mockDatabase.EXPECT().
			Connect(gomock.Any()).
			Return(nil).
			Times(1)

		// Execute test
		err := mockDatabase.Connect(ctx)

		// Assertions
		require.NoError(t, err)
	})

	// Test Ping success
	t.Run("Ping_Success", func(t *testing.T) {
		ctx := context.Background()

		// Setup expectations
		mockDatabase.EXPECT().
			Ping(gomock.Any()).
			Return(nil).
			Times(1)

		// Execute test
		err := mockDatabase.Ping(ctx)

		// Assertions
		require.NoError(t, err)
	})

	// Test Transaction
	t.Run("Transaction_Success", func(t *testing.T) {
		ctx := context.Background()
		mockTx := NewMockTransaction(ctrl)

		// Setup expectations
		mockDatabase.EXPECT().
			BeginTx(gomock.Any()).
			Return(mockTx, nil).
			Times(1)

		mockTx.EXPECT().
			Commit().
			Return(nil).
			Times(1)

		// Execute test
		tx, err := mockDatabase.BeginTx(ctx)
		require.NoError(t, err)

		err = tx.Commit()
		require.NoError(t, err)
	})
}

// TestIntegrationWithMocks demonstrates integration testing with multiple mocks
func TestIntegrationWithMocks(t *testing.T) {
	ctrl := gomock.NewController(t)
	defer ctrl.Finish()

	mockUserService := NewMockUserService(ctrl)
	mockAuthService := NewMockAuthService(ctrl)
	mockDatabase := NewMockDatabase(ctrl)

	// Test complete user registration flow
	t.Run("UserRegistration_CompleteFlow", func(t *testing.T) {
		ctx := context.Background()
		newUser := &User{
			Email: "new@example.com",
			Name:  "New User",
		}
		password := "password123"

		expectedLoginResponse := &LoginResponse{
			Token:        "jwt-token",
			RefreshToken: "refresh-token",
			User: &User{
				ID:    2,
				Email: newUser.Email,
				Name:  newUser.Name,
			},
		}

		// Setup database connection expectation
		mockDatabase.EXPECT().
			Connect(gomock.Any()).
			Return(nil).
			Times(1)

		// Setup user creation expectation
		mockUserService.EXPECT().
			CreateUser(gomock.Any(), gomock.Any()).
			DoAndReturn(func(ctx context.Context, user *User) error {
				user.ID = 2
				user.CreatedAt = time.Now()
				user.UpdatedAt = time.Now()
				return nil
			}).
			Times(1)

		// Setup registration expectation
		mockAuthService.EXPECT().
			Register(gomock.Any(), gomock.Any(), password).
			Return(expectedLoginResponse, nil).
			Times(1)

		// Execute test flow
		err := mockDatabase.Connect(ctx)
		require.NoError(t, err)

		err = mockUserService.CreateUser(ctx, newUser)
		require.NoError(t, err)

		response, err := mockAuthService.Register(ctx, newUser, password)
		require.NoError(t, err)

		// Assertions
		assert.Equal(t, expectedLoginResponse, response)
		assert.Equal(t, 2, newUser.ID)
		assert.NotEmpty(t, response.Token)
		assert.NotEmpty(t, response.RefreshToken)
	})
}

// TestMatchers demonstrates using gomock matchers
func TestMatchers(t *testing.T) {
	ctrl := gomock.NewController(t)
	defer ctrl.Finish()

	mockUserService := NewMockUserService(ctrl)

	t.Run("Matchers_AnyContext", func(t *testing.T) {
		ctx := context.Background()
		expectedUser := &User{ID: 1, Email: "test@example.com"}

		// Using gomock.Any() for context
		mockUserService.EXPECT().
			GetUserByID(gomock.Any(), 1).
			Return(expectedUser, nil).
			Times(1)

		user, err := mockUserService.GetUserByID(ctx, 1)
		require.NoError(t, err)
		assert.Equal(t, expectedUser, user)
	})

	t.Run("Matchers_DoAndReturn", func(t *testing.T) {
		ctx := context.Background()
		newUser := &User{Email: "test@example.com", Name: "Test User"}

		// Using DoAndReturn to modify the input parameter
		mockUserService.EXPECT().
			CreateUser(gomock.Any(), gomock.Any()).
			DoAndReturn(func(ctx context.Context, user *User) error {
				user.ID = 1
				user.CreatedAt = time.Now()
				user.UpdatedAt = time.Now()
				return nil
			}).
			Times(1)

		err := mockUserService.CreateUser(ctx, newUser)
		require.NoError(t, err)
		assert.Equal(t, 1, newUser.ID)
		assert.False(t, newUser.CreatedAt.IsZero())
	})
}


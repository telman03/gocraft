// ExampleTest shows how to write a table-driven test with testify
func TestExample(t *testing.T) {
	cases := []struct {
		name     string
		input    int
		expected int
	}{
		{"positive", 1, 2},
		{"zero", 0, 1},
	}

	for _, tc := range cases {
		t.Run(tc.name, func(t *testing.T) {
			result := tc.input + 1
			assert.Equal(t, tc.expected, result)
		})
	}
}


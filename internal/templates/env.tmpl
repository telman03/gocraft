# =============================================================================
# {{.ProjectName}} Environment Configuration
# =============================================================================
# Copy this file to .env and update the values for your environment
# Never commit .env files to version control!

# =============================================================================
# Server Configuration
# =============================================================================
APP_NAME={{.ProjectName}}
APP_ENV=development
PORT=8080
HOST=0.0.0.0
APP_VERSION=1.0.0

{{if .Flags.Auth}}
# =============================================================================
# Authentication & Security
# =============================================================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=168h
BCRYPT_COST=12
SESSION_SECRET=your-session-secret-key-change-in-production

{{end}}
{{if or .Flags.DB (contains .Features "postgresql") (contains .Features "mysql") (contains .Features "sqlite") (contains .Features "gorm")}}
# =============================================================================
# Database Configuration
# =============================================================================
{{if or (contains .Features "postgresql") (contains .Features "gorm")}}
# PostgreSQL Configuration
DATABASE_URL=postgres://postgres:password@localhost:5432/{{.ProjectName}}?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_NAME={{.ProjectName}}
DB_USER=postgres
DB_PASSWORD=password
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=300s

{{end}}
{{if contains .Features "mysql"}}
# MySQL Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE={{.ProjectName}}
MYSQL_USERNAME=root
MYSQL_PASSWORD=password
MYSQL_CHARSET=utf8mb4
MYSQL_PARSE_TIME=true
MYSQL_LOC=Local

{{end}}
{{if contains .Features "sqlite"}}
# SQLite Configuration
SQLITE_DATABASE=./{{.ProjectName}}.db
SQLITE_CACHE=shared
SQLITE_MODE=rwc

{{end}}
{{end}}
{{if contains .Features "redis"}}
# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_MAX_RETRIES=3
REDIS_MIN_RETRY_BACKOFF=8ms
REDIS_MAX_RETRY_BACKOFF=512ms

{{end}}
{{if contains .Features "mongodb"}}
# =============================================================================
# MongoDB Configuration
# =============================================================================
MONGODB_URL=mongodb://localhost:27017/{{.ProjectName}}
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE={{.ProjectName}}
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_AUTH_SOURCE=admin
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=0

{{end}}
{{if or (contains .Features "openai") (contains .Features "openrouter") (contains .Features "claude")}}
# =============================================================================
# AI/LLM Configuration
# =============================================================================
{{if contains .Features "openai"}}
# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.7

{{end}}
{{if contains .Features "openrouter"}}
# OpenRouter Configuration
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-3.5-turbo
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

{{end}}
{{if contains .Features "claude"}}
# Claude Configuration
CLAUDE_API_KEY=your-claude-api-key
CLAUDE_MODEL=claude-3-sonnet-20240229
CLAUDE_MAX_TOKENS=1000

{{end}}
{{end}}
{{if contains .Features "grpc"}}
# =============================================================================
# gRPC Configuration
# =============================================================================
GRPC_PORT=9090
GRPC_HOST=0.0.0.0
GRPC_MAX_RECV_MSG_SIZE=4194304
GRPC_MAX_SEND_MSG_SIZE=4194304
GRPC_KEEPALIVE_TIME=30s
GRPC_KEEPALIVE_TIMEOUT=5s

{{end}}
{{if contains .Features "websocket"}}
# =============================================================================
# WebSocket Configuration
# =============================================================================
WS_READ_BUFFER_SIZE=1024
WS_WRITE_BUFFER_SIZE=1024
WS_HANDSHAKE_TIMEOUT=10s
WS_CHECK_ORIGIN=false

{{end}}
# =============================================================================
# CORS Configuration
# =============================================================================
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-Requested-With,Accept,Origin
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=86400

{{if or (contains .Features "logging") (contains .Features "logger")}}
# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_OUTPUT=stdout
LOG_FILE=logs/app.log
LOG_MAX_SIZE=100
LOG_MAX_AGE=30
LOG_MAX_BACKUPS=10
LOG_COMPRESS=true

{{end}}
# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_BURST=200
RATE_LIMIT_SKIP_SUCCESSFUL=false

# =============================================================================
# File Upload Configuration
# =============================================================================
UPLOAD_MAX_SIZE=10MB
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,application/pdf,text/plain
UPLOAD_PATH=uploads
UPLOAD_CREATE_DIRS=true

# =============================================================================
# Email Configuration (SMTP)
# =============================================================================
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@{{.ProjectName}}.com
SMTP_FROM_NAME={{.ProjectName}}
SMTP_USE_TLS=true

# =============================================================================
# Email Service Configuration (Resend, SendGrid, etc.)
# =============================================================================
# Resend Configuration
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=noreply@{{.ProjectName}}.com
EMAIL_FROM_NAME={{.ProjectName}}

# SendGrid Configuration (alternative)
# SENDGRID_API_KEY=your-sendgrid-api-key
# SENDGRID_FROM_EMAIL=noreply@{{.ProjectName}}.com

{{if contains .Features "observability"}}
# =============================================================================
# Monitoring & Observability
# =============================================================================
# Prometheus Configuration
PROMETHEUS_ENABLED=true
PROMETHEUS_PATH=/metrics
PROMETHEUS_PORT=2112

# Sentry Configuration
SENTRY_DSN=your-sentry-dsn
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE={{.ProjectName}}@1.0.0
SENTRY_SAMPLE_RATE=1.0

# New Relic Configuration
NEW_RELIC_LICENSE_KEY=your-new-relic-license-key
NEW_RELIC_APP_NAME={{.ProjectName}}

# Datadog Configuration
DATADOG_API_KEY=your-datadog-api-key
DATADOG_SERVICE={{.ProjectName}}
DATADOG_ENV=development

{{end}}
# =============================================================================
# Cache Configuration
# =============================================================================
CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_PREFIX={{.ProjectName}}
CACHE_CLEANUP_INTERVAL=600

# =============================================================================
# Queue Configuration
# =============================================================================
QUEUE_ENABLED=false
QUEUE_REDIS_URL=redis://localhost:6379/1
QUEUE_WORKERS=5
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_DELAY=5s

# =============================================================================
# Health Check Configuration
# =============================================================================
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health
HEALTH_CHECK_TIMEOUT=5s
HEALTH_CHECK_INTERVAL=30s

# =============================================================================
# Development Configuration
# =============================================================================
DEBUG=true
HOT_RELOAD=true
AUTO_MIGRATE=true
ENABLE_PROFILER=false
ENABLE_SWAGGER=true

# =============================================================================
# Production Overrides (uncomment and modify for production)
# =============================================================================
# APP_ENV=production
# DEBUG=false
# LOG_LEVEL=info
# LOG_FORMAT=json
# CORS_ALLOW_ORIGINS=https://yourdomain.com
# JWT_SECRET=your-production-jwt-secret-min-32-chars
# DATABASE_URL=postgres://user:pass@prod-db:5432/dbname?sslmode=require
# REDIS_URL=redis://prod-redis:6379
# RATE_LIMIT_REQUESTS=1000
# CACHE_TTL=7200

# =============================================================================
# External Services (uncomment as needed)
# =============================================================================
# Stripe Configuration
# STRIPE_SECRET_KEY=your-stripe-secret-key
# STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
# STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# AWS Configuration
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_S3_BUCKET=your-s3-bucket

# Google Cloud Configuration
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
# GCP_PROJECT_ID=your-gcp-project-id

# Twilio Configuration
# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_PHONE_NUMBER=your-twilio-phone-number 
# Application Configuration
APP_NAME={{.ProjectName}}
APP_ENV=development
APP_PORT=8080
APP_HOST=0.0.0.0
APP_VERSION=1.0.0

# Database Configuration
DATABASE_URL=postgres://postgres:password@localhost:5432/{{.ProjectName}}?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_NAME={{.ProjectName}}
DB_USER=postgres
DB_PASSWORD=password
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=300s

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10

# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017/{{.ProjectName}}
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE={{.ProjectName}}
MONGODB_USERNAME=
MONGODB_PASSWORD=

# Authentication & Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=168h
BCRYPT_COST=12
SESSION_SECRET=your-session-secret-key

# CORS Configuration
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-Requested-With
CORS_ALLOW_CREDENTIALS=true

# Logging Configuration
LOG_LEVEL=debug
LOG_FORMAT=json
LOG_FILE=logs/app.log
LOG_MAX_SIZE=100
LOG_MAX_AGE=30
LOG_MAX_BACKUPS=10

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_BURST=200

# File Upload Configuration
UPLOAD_MAX_SIZE=10MB
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,application/pdf
UPLOAD_PATH=uploads

# Email Configuration (if needed)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@{{.ProjectName}}.com

# External APIs (if needed)
OPENAI_API_KEY=your-openai-api-key
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# Monitoring & Analytics
SENTRY_DSN=your-sentry-dsn
NEW_RELIC_LICENSE_KEY=your-new-relic-license-key
DATADOG_API_KEY=your-datadog-api-key

# Cache Configuration
CACHE_TTL=3600
CACHE_PREFIX={{.ProjectName}}

# Queue Configuration (if using Redis for queues)
QUEUE_REDIS_URL=redis://localhost:6379/1
QUEUE_WORKERS=5

# Health Check Configuration
HEALTH_CHECK_TIMEOUT=5s
HEALTH_CHECK_INTERVAL=30s

# Development Specific
DEBUG=true
HOT_RELOAD=true
AUTO_MIGRATE=true

# Production Specific (override in production)
# APP_ENV=production
# DEBUG=false
# LOG_LEVEL=info
# CORS_ALLOW_ORIGINS=https://yourdomain.com
# JWT_SECRET=your-production-jwt-secret
# DATABASE_URL=postgres://user:pass@prod-db:5432/dbname?sslmode=require 
package docs

import "github.com/gofiber/fiber/v2"

// SetupRedoc mounts a ReDoc UI at /docs
func SetupRedoc(app *fiber.App) {
	// Serve the OpenAPI spec (generated by swag or placed manually)
	app.Static("/docs/spec", "./docs/swagger.json")

	// Serve ReDoc from a CDN — no build step required
	app.Get("/docs", func(c *fiber.Ctx) error {
		c.Set("Content-Type", "text/html")
		return c.SendString(`<!DOCTYPE html>
<html>
  <head>
    <title>{{.ProjectName}} API Docs</title>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://fonts.googleapis.com/css?family=Montserrat:300,400,700|Roboto:300,400,700" rel="stylesheet">
    <style>body { margin: 0; padding: 0; }</style>
  </head>
  <body>
    <redoc spec-url='/docs/spec/swagger.json'></redoc>
    <script src="https://cdn.jsdelivr.net/npm/redoc@latest/bundles/redoc.standalone.js"></script>
  </body>
</html>`)
	})
}

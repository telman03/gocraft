# 🔧 GoCraft Environment Configuration
# =====================================================
# Copy this file to .env and update with your actual values
# For local development, you can also use .env.local
# 
# ⚠️  SECURITY WARNING: Never commit .env files to version control!
# =====================================================

# =============================================================================
# 🗄️ Database Configuration
# =============================================================================
# PostgreSQL database connection settings
# For production, use a secure database with SSL enabled
DB_HOST=localhost
DB_PORT=5432
DB_USER=gocraft
DB_PASSWORD=your_secure_password_here
DB_NAME=gocraft_db
# SSL mode: disable (dev), require (prod), verify-full (most secure)
DB_SSLMODE=disable

# Optional: Database connection pool settings
# DB_MAX_OPEN_CONNS=25
# DB_MAX_IDLE_CONNS=5
# DB_CONN_MAX_LIFETIME=300s

# =============================================================================
# 🔐 Security Configuration
# =============================================================================
# JWT secret key - MUST be at least 32 characters for security
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=168h

# Password hashing cost (10-14 recommended, higher = more secure but slower)
BCRYPT_COST=12

# Session configuration (if using sessions)
# SESSION_SECRET=your-session-secret-key-change-in-production

# =============================================================================
# 📧 Email Configuration (for OTP verification)
# =============================================================================
# Resend.com API configuration for sending emails
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=GoCraft

# Email templates and settings
# EMAIL_TEMPLATE_DIR=./templates/emails
# EMAIL_TIMEOUT=30s

# =============================================================================
# 🚀 Server Configuration
# =============================================================================
# Server port and environment settings
PORT=8080
APP_ENV=development
APP_NAME=GoCraft

# Server timeouts and limits
# SERVER_READ_TIMEOUT=30s
# SERVER_WRITE_TIMEOUT=30s
# SERVER_IDLE_TIMEOUT=120s
# MAX_REQUEST_SIZE=10MB

# =============================================================================
# 📊 Admin Configuration
# =============================================================================
# Default admin user credentials (used by setup scripts)
# ⚠️  Change these immediately after first setup!
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change_this_secure_admin_password

# Admin panel settings
# ADMIN_SESSION_TIMEOUT=3600s
# ADMIN_MAX_LOGIN_ATTEMPTS=5

# =============================================================================
# 🔧 Maintenance & Operations
# =============================================================================
# System maintenance settings
MAINTENANCE_ENABLED=false
FILE_RETENTION_DAYS=30
CLEANUP_INTERVAL_HOURS=24

# Backup and cleanup settings
# BACKUP_ENABLED=true
# BACKUP_INTERVAL_HOURS=24
# BACKUP_RETENTION_DAYS=7

# =============================================================================
# 📊 Monitoring & Logging
# =============================================================================
# Logging configuration
LOG_LEVEL=info
LOG_FORMAT=json
# LOG_FILE=./logs/app.log

# Metrics and monitoring
# METRICS_ENABLED=true
# METRICS_PORT=9090
# HEALTH_CHECK_INTERVAL=30s

# =============================================================================
# 🔄 Rate Limiting & Security
# =============================================================================
# API rate limiting settings
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REQUESTS=100
# RATE_LIMIT_WINDOW=3600s

# CORS settings
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
# CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
# CORS_ALLOWED_HEADERS=Content-Type,Authorization

# =============================================================================
# 🐳 Docker & Deployment
# =============================================================================
# Docker-specific settings (uncomment when using Docker)
# DOCKER_ENV=true
# CONTAINER_PORT=8080

# Load balancer and proxy settings
# PROXY_ENABLED=false
# TRUSTED_PROXIES=127.0.0.1,::1

# =============================================================================
# 🧪 Development & Testing
# =============================================================================
# Development-only settings (not used in production)
# DEBUG_ENABLED=false
# PROFILING_ENABLED=false
# TEST_DATABASE_URL=postgres://test:test@localhost:5432/gocraft_test

# =============================================================================
# 📝 Additional Notes
# =============================================================================
# 1. All sensitive values should be changed before production deployment
# 2. Use strong, unique passwords and secrets
# 3. Enable SSL/TLS in production (DB_SSLMODE=require)
# 4. Consider using environment-specific .env files (.env.production, .env.staging)
# 5. Use a secrets management service for production deployments
# 6. Regularly rotate secrets and API keys
# 7. Monitor logs for security events and unauthorized access attempts
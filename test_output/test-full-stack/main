package main

import (
	"log"
	"os"
	"github.com/gofiber/fiber/v2"
	
	
	"test-full-stack/internal/auth"
	"test-full-stack/internal/db"
	"test-full-stack/internal/router"
	"test-full-stack/internal/config"
)

func main() {
	config.Load()
	db.Connect()

	
	// Fiber framework
	app := fiber.New(fiber.Config{
		AppName: "test-full-stack",
	})
	router.SetupRoutes(app)
	
	port := os.Getenv("PORT")
	if port == "" {
		port = "8080"
	}
	
	log.Printf("Server starting on port %s", port)
	log.Fatal(app.Listen(":" + port))
	
}
// SetupMiddleware configures all middleware for the application
func SetupMiddleware(app *fiber.App) {
	// Basic security and performance middleware
	app.Use(helmet.New())
	app.Use(compress.New())
	app.Use(etag.New())
	
	// Request ID for tracing
	app.Use(requestid.New())
	
	// CORS configuration
	app.Use(cors.New(cors.Config{
		AllowOrigins:     getEnv("CORS_ALLOW_ORIGINS", "*"),
		AllowMethods:     getEnv("CORS_ALLOW_METHODS", "GET,POST,PUT,DELETE,OPTIONS"),
		AllowHeaders:     getEnv("CORS_ALLOW_HEADERS", "Content-Type,Authorization,X-Requested-With"),
		AllowCredentials: true,
		MaxAge:           300,
	}))
	
	// Rate limiting
	app.Use(limiter.New(limiter.Config{
		Max:        getEnvAsInt("RATE_LIMIT_REQUESTS", 100),
		Expiration: getEnvAsDuration("RATE_LIMIT_WINDOW", 1*time.Minute),
		KeyGenerator: func(c *fiber.Ctx) string {
			return c.IP()
		},
		LimitReached: func(c *fiber.Ctx) error {
			return c.Status(429).JSON(fiber.Map{
				"error": "Too many requests",
				"retry_after": c.Get("Retry-After"),
			})
		},
	}))
	
	// Request timeout
	app.Use(timeout.New(timeout.Config{
		Timeout: getEnvAsDuration("REQUEST_TIMEOUT", 30*time.Second),
		ErrorHandler: func(c *fiber.Ctx, err error) error {
			return c.Status(408).JSON(fiber.Map{
				"error": "Request timeout",
			})
		},
	}))
	
	// Logging middleware
	app.Use(logger.New(logger.Config{
		Format:     "${time} | ${status} | ${latency} | ${method} | ${path} | ${ip}\n",
		TimeFormat: "2006-01-02 15:04:05",
		Output:     logger.Log.Writer(),
	}))
	
	// Custom request logging
	app.Use(customRequestLogger)
	
	// Panic recovery
	app.Use(recover.New(recover.Config{
		EnableStackTrace: true,
		StackTraceHandler: func(c *fiber.Ctx, e interface{}) {
			// Log panic to console in development
			if getEnv("APP_ENV", "development") == "development" {
				fiber.DefaultErrorHandler(c, fiber.NewError(500, "Internal Server Error"))
			}
		},
	}))
	
	// Cache middleware for static assets
	app.Use("/static/*", cache.New(cache.Config{
		Expiration:   1 * time.Hour,
		CacheControl: true,
	}))
	
	// Development middleware
	if getEnv("APP_ENV", "development") == "development" {
		// Pprof for debugging
		app.Use("/debug/*", pprof.New())
		
		// Monitor dashboard
		app.Get("/monitor", monitor.New())
	}
}


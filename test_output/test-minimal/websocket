// WebSocketManager manages WebSocket connections
type WebSocketManager struct {
	clients    map[string]*Client
	broadcast  chan Message
	register   chan *Client
	unregister chan *Client
	mutex      sync.RWMutex
}

// Client represents a WebSocket client connection
type Client struct {
	ID       string
	UserID   int
	Username string
	Conn     *websocket.Conn
	Send     chan []byte
	Manager  *WebSocketManager
}

// Message represents a WebSocket message
type Message struct {
	Type      string      `json:"type"`
	UserID    int         `json:"user_id,omitempty"`
	Username  string      `json:"username,omitempty"`
	Content   string      `json:"content,omitempty"`
	RoomID    string      `json:"room_id,omitempty"`
	Data      interface{} `json:"data,omitempty"`
	Timestamp time.Time   `json:"timestamp"`
}

// ChatMessage represents a chat message
type ChatMessage struct {
	ID        int       `json:"id"`
	UserID    int       `json:"user_id"`
	Username  string    `json:"username"`
	Content   string    `json:"content"`
	RoomID    string    `json:"room_id"`
	Type      string    `json:"type"` // text, image, file, system
	CreatedAt time.Time `json:"created_at"`
}

// Notification represents a notification
type Notification struct {
	ID        int       `json:"id"`
	UserID    int       `json:"user_id"`
	Title     string    `json:"title"`
	Message   string    `json:"message"`
	Type      string    `json:"type"` // info, warning, error, success
	Read      bool      `json:"read"`
	CreatedAt time.Time `json:"created_at"`
}

// NewWebSocketManager creates a new WebSocket manager
func NewWebSocketManager() *WebSocketManager {
	return &WebSocketManager{
		clients:    make(map[string]*Client),
		broadcast:  make(chan Message),
		register:   make(chan *Client),
		unregister: make(chan *Client),
	}
}

// Start starts the WebSocket manager
func (wm *WebSocketManager) Start() {
	for {
		select {
		case client := <-wm.register:
			wm.mutex.Lock()
			wm.clients[client.ID] = client
			wm.mutex.Unlock()
			
			// Send welcome message
			welcomeMsg := Message{
				Type:      "connected",
				Content:   "Connected to WebSocket server",
				Timestamp: time.Now(),
			}
			client.Send <- wm.serializeMessage(welcomeMsg)
			
			// Broadcast user joined
			joinMsg := Message{
				Type:      "user_joined",
				UserID:    client.UserID,
				Username:  client.Username,
				Content:   fmt.Sprintf("%s joined the chat", client.Username),
				Timestamp: time.Now(),
			}
			wm.broadcast <- joinMsg

		case client := <-wm.unregister:
			wm.mutex.Lock()
			if _, ok := wm.clients[client.ID]; ok {
				delete(wm.clients, client.ID)
				close(client.Send)
			}
			wm.mutex.Unlock()
			
			// Broadcast user left
			leaveMsg := Message{
				Type:      "user_left",
				UserID:    client.UserID,
				Username:  client.Username,
				Content:   fmt.Sprintf("%s left the chat", client.Username),
				Timestamp: time.Now(),
			}
			wm.broadcast <- leaveMsg

		case message := <-wm.broadcast:
			wm.mutex.RLock()
			for _, client := range wm.clients {
				select {
				case client.Send <- wm.serializeMessage(message):
				default:
					close(client.Send)
					delete(wm.clients, client.ID)
				}
			}
			wm.mutex.RUnlock()
		}
	}
}

// serializeMessage serializes a message to JSON
func (wm *WebSocketManager) serializeMessage(msg Message) []byte {
	data, err := json.Marshal(msg)
	if err != nil {
		log.Printf("Error serializing message: %v", err)
		return nil
	}
	return data
}

// BroadcastToRoom broadcasts a message to a specific room
func (wm *WebSocketManager) BroadcastToRoom(roomID string, message Message) {
	wm.mutex.RLock()
	defer wm.mutex.RUnlock()
	
	for _, client := range wm.clients {
		// In a real implementation, you'd check if client is in the room
		select {
		case client.Send <- wm.serializeMessage(message):
		default:
			close(client.Send)
			delete(wm.clients, client.ID)
		}
	}
}

// SendToUser sends a message to a specific user
func (wm *WebSocketManager) SendToUser(userID int, message Message) {
	wm.mutex.RLock()
	defer wm.mutex.RUnlock()
	
	for _, client := range wm.clients {
		if client.UserID == userID {
			select {
			case client.Send <- wm.serializeMessage(message):
			default:
				close(client.Send)
				delete(wm.clients, client.ID)
			}
		}
	}
}

// GetConnectedUsers returns a list of connected users
func (wm *WebSocketManager) GetConnectedUsers() []map[string]interface{} {
	wm.mutex.RLock()
	defer wm.mutex.RUnlock()
	
	var users []map[string]interface{}
	for _, client := range wm.clients {
		users = append(users, map[string]interface{}{
			"id":       client.ID,
			"user_id":  client.UserID,
			"username": client.Username,
		})
	}
	return users
}

// SetupWebSocketRoutes sets up WebSocket routes
func SetupWebSocketRoutes(app *fiber.App, wsManager *WebSocketManager) {
	// WebSocket upgrade handler
	app.Use("/ws", func(c *fiber.Ctx) error {
		// Check if the request is a WebSocket upgrade
		if websocket.IsWebSocketUpgrade(c) {
			c.Locals("allowed", true)
			return c.Next()
		}
		return fiber.ErrUpgradeRequired
	})

	// WebSocket routes
	app.Get("/ws/chat", websocket.New(func(c *websocket.Conn) {
		handleChatWebSocket(c, wsManager)
	}))

	app.Get("/ws/notifications", websocket.New(func(c *websocket.Conn) {
		handleNotificationWebSocket(c, wsManager)
	}))

	app.Get("/ws/general", websocket.New(func(c *websocket.Conn) {
		handleGeneralWebSocket(c, wsManager)
	}))

	// REST endpoints for WebSocket management
	app.Get("/ws/users", func(c *fiber.Ctx) error {
		users := wsManager.GetConnectedUsers()
		return c.JSON(fiber.Map{
			"users": users,
			"count": len(users),
		})
	})

	app.Post("/ws/broadcast", func(c *fiber.Ctx) error {
		var msg Message
		if err := c.BodyParser(&msg); err != nil {
			return c.Status(400).JSON(fiber.Map{
				"error": "Invalid message format",
			})
		}

		msg.Timestamp = time.Now()
		wsManager.broadcast <- msg

		return c.JSON(fiber.Map{
			"message": "Message broadcasted successfully",
		})
	})
}

// handleChatWebSocket handles chat WebSocket connections
func handleChatWebSocket(conn *websocket.Conn, manager *WebSocketManager) {
	// Extract user info from query parameters or headers
	userID := conn.Query("user_id")
	username := conn.Query("username")
	
	if userID == "" || username == "" {
		conn.WriteJSON(fiber.Map{
			"error": "user_id and username are required",
		})
		conn.Close()
		return
	}

	// Create client
	client := &Client{
		ID:       generateClientID(),
		UserID:   parseUserID(userID),
		Username: username,
		Conn:     conn,
		Send:     make(chan []byte, 256),
		Manager:  manager,
	}

	// Register client
	manager.register <- client

	// Start goroutines for reading and writing
	go client.writePump()
	go client.readPump()
}


// handlePingMessage handles ping messages
func handlePingMessage(client *Client) {
	pongMsg := Message{
		Type:      "pong",
		Timestamp: time.Now(),
	}

	client.Send <- client.Manager.serializeMessage(pongMsg)
}

// ChatService provides chat functionality
type ChatService struct {
	wsManager *WebSocketManager
	db        Database
}

// NewChatService creates a new chat service
func NewChatService(wsManager *WebSocketManager, db Database) *ChatService {
	return &ChatService{
		wsManager: wsManager,
		db:        db,
	}
}

// SendMessage sends a chat message
func (cs *ChatService) SendMessage(userID int, content, roomID string) error {
	// Save message to database
	chatMsg := &ChatMessage{
		UserID:    userID,
		Content:   content,
		RoomID:    roomID,
		Type:      "text",
		CreatedAt: time.Now(),
	}

	err := cs.db.SaveChatMessage(chatMsg)
	if err != nil {
		return err
	}

	// Broadcast message
	msg := Message{
		Type:      "chat",
		UserID:    userID,
		Content:   content,
		RoomID:    roomID,
		Timestamp: time.Now(),
	}

	cs.wsManager.BroadcastToRoom(roomID, msg)
	return nil
}

// GetMessages retrieves chat messages
func (cs *ChatService) GetMessages(roomID string, limit, offset int) ([]*ChatMessage, error) {
	return cs.db.GetChatMessages(roomID, limit, offset)
}

// NotificationService provides notification functionality
type NotificationService struct {
	wsManager *WebSocketManager
	db        Database
}

// NewNotificationService creates a new notification service
func NewNotificationService(wsManager *WebSocketManager, db Database) *NotificationService {
	return &NotificationService{
		wsManager: wsManager,
		db:        db,
	}
}

// SendNotification sends a notification to a user
func (cs *NotificationService) SendNotification(userID int, title, message, notificationType string) error {
	// Save notification to database
	notification := &Notification{
		UserID:    userID,
		Title:     title,
		Message:   message,
		Type:      notificationType,
		Read:      false,
		CreatedAt: time.Now(),
	}

	err := cs.db.SaveNotification(notification)
	if err != nil {
		return err
	}

	// Send via WebSocket
	msg := Message{
		Type:      "notification",
		UserID:    userID,
		Content:   title,
		Data:      notification,
		Timestamp: time.Now(),
	}

	cs.wsManager.SendToUser(userID, msg)
	return nil
}

// GetNotifications retrieves notifications for a user
func (cs *NotificationService) GetNotifications(userID int, limit, offset int) ([]*Notification, error) {
	return cs.db.GetNotifications(userID, limit, offset)
}

// MarkNotificationAsRead marks a notification as read
func (cs *NotificationService) MarkNotificationAsRead(notificationID int) error {
	return cs.db.MarkNotificationAsRead(notificationID)
}

// Helper functions

func generateClientID() string {
	b := make([]byte, 16)
	rand.Read(b)
	return fmt.Sprintf("client_%x", b)
}

func parseUserID(userID string) int {
	id, err := strconv.Atoi(userID)
	if err != nil {
		return 0
	}
	return id
}

// Database interface for WebSocket operations
type Database interface {
	SaveChatMessage(message *ChatMessage) error
	GetChatMessages(roomID string, limit, offset int) ([]*ChatMessage, error)
	SaveNotification(notification *Notification) error
	GetNotifications(userID int, limit, offset int) ([]*Notification, error)
	MarkNotificationAsRead(notificationID int) error
}

// Setup WebSocket routes with Fiber
func SetupFiberWebSocketRoutes(app *fiber.App, wsManager *WebSocketManager) {
	// WebSocket upgrade middleware
	app.Use("/ws", func(c *fiber.Ctx) error {
		// Check if the request is a WebSocket upgrade
		if websocket.IsWebSocketUpgrade(c) {
			c.Locals("allowed", true)
			return c.Next()
		}
		return fiber.ErrUpgradeRequired
	})

	// WebSocket routes
	app.Get("/ws/chat", websocket.New(func(c *websocket.Conn) {
		handleChatWebSocket(c, wsManager)
	}))

	app.Get("/ws/notifications", websocket.New(func(c *websocket.Conn) {
		handleNotificationWebSocket(c, wsManager)
	}))

	app.Get("/ws/general", websocket.New(func(c *websocket.Conn) {
		handleGeneralWebSocket(c, wsManager)
	}))
}

// Main function to start WebSocket server
func main() {
	app := fiber.New()

	// Initialize WebSocket manager
	wsManager := NewWebSocketManager()
	go wsManager.Start()

	// Setup WebSocket routes
	SetupFiberWebSocketRoutes(app, wsManager)

	// Start server
	log.Fatal(app.Listen(":8080"))
} 